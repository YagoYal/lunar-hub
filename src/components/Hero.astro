---
---

<section id="hero" class="hero">
	<h1>Lunar science, straight from the sources</h1>
	<p>
		Lunar Hub gathers and summarizes real findings about the Moon —
		missions, geology, ice, exploration — always credited and linked
		back to the original source (NASA, ESA, JAXA, and other public
		contributors). We don't reproduce full articles: we curate and
		point to the real research.
	</p>
	<div class="cta">
		<a class="button" href="#latest">See latest findings</a>
		<a class="link" href="https://lunar-ice.vercel.app">
			Check out Lunar Ice Intelligence →
		</a>
	</div>

	<figure class="moon-figure">
		<model-viewer
			id="moon-model"
			class="moon-model"
			src="/models/moon.glb"
			poster="/models/moon-poster.svg"
			alt="Stylized 3D model of the Moon"
			auto-rotate
			rotation-per-second="6deg"
			camera-controls
			loading="lazy"
			reveal="auto"
			shadow-intensity="0.6"
			exposure="1"
		></model-viewer>
		<figcaption>
			Illustrative, procedurally generated 3D model — not real lunar
			terrain data. Drag to rotate and explore.
		</figcaption>
	</figure>
</section>

<script>
	// <model-viewer> self-registers once imported.
	import "@google/model-viewer";

	// Respect prefers-reduced-motion: disable auto-rotate (the model
	// stays fully interactive via camera-controls).
	const motionQuery = window.matchMedia("(prefers-reduced-motion: reduce)");
	const moonModel = document.getElementById("moon-model");

	function applyMotionPreference(reduceMotion: boolean) {
		if (!moonModel) return;
		if (reduceMotion) {
			moonModel.removeAttribute("auto-rotate");
		} else {
			moonModel.setAttribute("auto-rotate", "");
		}
	}

	applyMotionPreference(motionQuery.matches);
	motionQuery.addEventListener("change", (event) => applyMotionPreference(event.matches));
</script>

<style>
	.hero {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--space-6) var(--space-3) var(--space-5);
		text-align: center;
	}

	.hero h1 {
		font-size: clamp(1.75rem, 4vw, 2.75rem);
		margin-bottom: var(--space-2);
	}

	.hero p {
		max-width: 40rem;
		margin: 0 auto var(--space-4);
		font-size: 1.0625rem;
	}

	.cta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: var(--space-3);
	}

	.button {
		display: inline-block;
		background: var(--primary);
		color: #fff;
		text-decoration: none;
		font-weight: 600;
		padding: 0.75rem 1.5rem;
		border-radius: var(--radius);
		transition: background 0.15s ease;
	}

	.button:hover {
		background: var(--primary-dark);
		color: #fff;
	}

	.link {
		text-decoration: none;
		font-size: 0.9375rem;
	}

	.moon-figure {
		margin: var(--space-5) auto 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-1);
	}

	.moon-model {
		width: 16rem;
		height: 16rem;
		max-width: 90vw;
		background-color: transparent;
		--poster-color: transparent;
	}

	.moon-figure figcaption {
		max-width: 24rem;
		font-size: 0.75rem;
		color: var(--text-muted);
		line-height: 1.5;
	}

	@media (max-width: 400px) {
		.moon-model {
			width: 12rem;
			height: 12rem;
		}
	}
</style>
