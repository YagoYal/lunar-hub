---
interface Props {
	organizations: string[];
	/** CSS selector for the list items to show/hide (each must have data-org) */
	targetSelector: string;
}

const { organizations, targetSelector } = Astro.props;
---

<div id="by-source" class="by-source-filter" data-target={targetSelector}>
	<button type="button" class="chip is-active" data-filter="">Todas</button>
	{
		organizations.map((org) => (
			<button type="button" class="chip" data-filter={org}>
				{org}
			</button>
		))
	}
</div>

<style>
	.by-source-filter {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1);
		margin-bottom: var(--space-3);
	}

	.chip {
		font: inherit;
		font-size: 0.8125rem;
		font-weight: 600;
		cursor: pointer;
		background: var(--surface);
		color: var(--text-muted);
		border: 1px solid var(--border);
		border-radius: 999px;
		padding: 0.375rem 0.875rem;
	}

	.chip:hover {
		border-color: var(--primary);
		color: var(--primary-dark);
	}

	.chip.is-active {
		background: var(--primary);
		border-color: var(--primary);
		color: #fff;
	}
</style>

<script>
	// Plain vanilla JS — no framework needed for a simple show/hide filter.
	document.querySelectorAll<HTMLElement>(".by-source-filter").forEach((filterBar) => {
		const targetSelector = filterBar.dataset.target;
		if (!targetSelector) return;
		const items = document.querySelectorAll<HTMLElement>(targetSelector);

		filterBar.addEventListener("click", (event) => {
			const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
				"button[data-filter]",
			);
			if (!button) return;

			filterBar
				.querySelectorAll(".chip")
				.forEach((chip) => chip.classList.remove("is-active"));
			button.classList.add("is-active");

			const filter = button.dataset.filter ?? "";
			items.forEach((item) => {
				const matches = filter === "" || item.dataset.org === filter;
				item.hidden = !matches;
			});
		});
	});
</script>
