---
const year = new Date().getFullYear();
---

<footer id="about" class="site-footer">
	<div class="footer-inner">
		<div>
			<strong>Lunar Hub</strong>
			<p>
				Curated lunar science from public sources. Third-party content
				follows the license of its original source.
			</p>
		</div>
		<ul class="footer-links">
			<li><a href="#methodology">Methodology</a></li>
			<li>
				<a href="https://lunar-ice.vercel.app">Lunar Ice Intelligence</a>
			</li>
		</ul>
	</div>
	<p class="fine-print">
		© {year} Lunar Hub — original content under CC BY-NC 4.0
		(non-commercial use). Third-party research belongs to its original
		sources.
	</p>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		background: var(--surface-alt);
		padding: var(--space-5) var(--space-3) var(--space-4);
	}

	.footer-inner {
		max-width: var(--content-width);
		margin: 0 auto;
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.footer-inner p {
		max-width: 24rem;
		font-size: 0.875rem;
	}

	.footer-links {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		margin: 0;
		padding: 0;
	}

	.footer-links a {
		text-decoration: none;
		font-size: 0.9375rem;
	}

	.fine-print {
		max-width: var(--content-width);
		margin: var(--space-4) auto 0;
		font-size: 0.8125rem;
		color: var(--text-muted);
	}
</style>
