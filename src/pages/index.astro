---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import FindingsGrid from "../components/FindingsGrid.astro";
import FindingsCarousel from "../components/FindingsCarousel";
import BySourceFilter from "../components/BySourceFilter.astro";
import MethodologySection from "../components/MethodologySection.astro";
import SecurityBackendSection from "../components/SecurityBackendSection.astro";
import { getPublishedFindings, toFindingSummary } from "../lib/findings";

const findings = await getPublishedFindings();
const organizations = [...new Set(findings.map((f) => f.data.sourceOrganization))];
const findingSummaries = findings.map(toFindingSummary);
---

<BaseLayout>
	<Header />
	<main>
		<Hero />

		<section id="latest" class="latest">
			<h2>Últimas descobertas</h2>
			<BySourceFilter
				organizations={organizations}
				targetSelector=".findings-grid > li"
			/>
			<FindingsGrid entries={findings} />
			<div class="mobile-carousel">
				<FindingsCarousel client:visible entries={findingSummaries} />
			</div>
		</section>

		<MethodologySection />
		<SecurityBackendSection />
	</main>
	<Footer />
</BaseLayout>

<style>
	.latest {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--space-5) var(--space-3);
		border-top: 1px solid var(--border);
	}

	/* Grid handles >40rem (see FindingsGrid.astro); carousel takes over below it. */
	.mobile-carousel {
		display: none;
	}

	@media (max-width: 40rem) {
		.mobile-carousel {
			display: block;
		}
	}
</style>
